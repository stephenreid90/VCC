{
  "$defs": {
    "Confidence": {
      "description": "Pinned meaning: joint confidence in direction x magnitude.",
      "enum": [
        "low",
        "moderate",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "DecayHorizon": {
      "additionalProperties": false,
      "description": "How long an excess return is assumed to last, as a value rather than a sentence.\n\nD-58's implementation. Before this the horizon lived as prose inside\n``DriverMovement.rationale`` \u2014 \"decay horizon = 10-15 years\" is a sentence, so\nthere was nothing for a validator to read and nothing a test could hold to the\nrule, on a quantity \u00a712 puts at 15-20% of terminal value. Dated horizons carry\na band because that is how the evidence arrives; ``indefinite`` is admissible\nfor a barrier of any kind under D-58, but never by omission.",
      "properties": {
        "years_low": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Years Low"
        },
        "years_high": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Years High"
        },
        "indefinite": {
          "default": false,
          "title": "Indefinite",
          "type": "boolean"
        },
        "basis": {
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "basis"
      ],
      "title": "DecayHorizon",
      "type": "object"
    },
    "Direction": {
      "description": "Matrix entry direction. Separate from magnitude (section 10.2).",
      "enum": [
        "negative",
        "neutral",
        "positive"
      ],
      "title": "Direction",
      "type": "string"
    },
    "DriverMovement": {
      "additionalProperties": false,
      "description": "One cell of the impact matrix \u2014 scenario x archetype x driver.",
      "properties": {
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "magnitude": {
          "$ref": "#/$defs/Magnitude"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "quantified_override": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuantifiedBand"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "not_applicable": {
          "default": false,
          "description": "True where the driver does not apply to this archetype (distinct from direction == neutral, which means 'applies but scenario doesn't move it').",
          "title": "Not Applicable",
          "type": "boolean"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "governance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Governance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "excess_return_defence": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExcessReturnDefence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "direction",
        "magnitude",
        "confidence",
        "rationale"
      ],
      "title": "DriverMovement",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Used across the schema for traceability (sections 10.3, 10.4, 8.4).",
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "date_accessed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Accessed"
        }
      },
      "required": [
        "source_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ExcessReturnDefence": {
      "additionalProperties": false,
      "description": "The \u00a710.6 rule 2 defended exception, structured (D-42).\n\nD-42 requires that where a terminal return exceeds the cost of capital, the\nvaluation names four things: the moat source, the decay horizon, the threat,\nand a sensitivity test. All four were expressible in prose and one of them \u2014\nthe horizon \u2014 is a number, which is why the prose form could never be checked.\n\n``moat_sources`` must name barrier-bearing sources. D-43a separated a RENT (a\ncash advantage with an end date, carried in the explicit period) from a BARRIER\n(what stops a rival taking the business, which is what the decay horizon\nmeasures), so defending a terminal excess return on a rent-bearing source is\nthe confusion that ruling exists to prevent. The tie to ``Moat.source_roles``\nis not enforced here because the moat lives on the company file and this on the\narchetype matrix; the ratchet test is where the two are compared.",
      "properties": {
        "moat_sources": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Moat Sources",
          "type": "array"
        },
        "decay_horizon": {
          "$ref": "#/$defs/DecayHorizon"
        },
        "named_threat": {
          "title": "Named Threat",
          "type": "string"
        },
        "sensitivity": {
          "title": "Sensitivity",
          "type": "string"
        },
        "finite_horizon_sensitivity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finite Horizon Sensitivity"
        },
        "declared_terminal_return": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared Terminal Return"
        },
        "declared_terminal_return_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared Terminal Return Basis"
        }
      },
      "required": [
        "moat_sources",
        "decay_horizon",
        "named_threat",
        "sensitivity"
      ],
      "title": "ExcessReturnDefence",
      "type": "object"
    },
    "Governance": {
      "additionalProperties": false,
      "description": "Per-entry / per-override governance audit (sections 10.3 and 10.4).",
      "properties": {
        "created_by": {
          "title": "Created By",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "approved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved By"
        },
        "approved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At"
        },
        "last_reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Reviewed At"
        }
      },
      "required": [
        "created_by",
        "created_at"
      ],
      "title": "Governance",
      "type": "object"
    },
    "ImpactMatrixEntry": {
      "additionalProperties": false,
      "description": "All driver movements for one scenario under one archetype (section 10.3).",
      "properties": {
        "scenario": {
          "title": "Scenario",
          "type": "string"
        },
        "scenario_version": {
          "title": "Scenario Version",
          "type": "string"
        },
        "drivers": {
          "additionalProperties": {
            "$ref": "#/$defs/DriverMovement"
          },
          "description": "Map from driver id (Layer 4) to its movement. Absent drivers imply direction == neutral and were not explicitly assessed (per the section 10.2 sparse-representation convention).",
          "title": "Drivers",
          "type": "object"
        }
      },
      "required": [
        "scenario",
        "scenario_version",
        "drivers"
      ],
      "title": "ImpactMatrixEntry",
      "type": "object"
    },
    "Magnitude": {
      "description": "Matrix entry magnitude. Separate from direction (section 10.2).",
      "enum": [
        "small",
        "moderate",
        "large"
      ],
      "title": "Magnitude",
      "type": "string"
    },
    "QuantifiedBand": {
      "additionalProperties": false,
      "description": "Optional quantified override of the ordinal direction x magnitude (section 10.2).",
      "properties": {
        "min": {
          "title": "Min",
          "type": "number"
        },
        "mid": {
          "title": "Mid",
          "type": "number"
        },
        "max": {
          "title": "Max",
          "type": "number"
        }
      },
      "required": [
        "min",
        "mid",
        "max"
      ],
      "title": "QuantifiedBand",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The impact matrix for one industry archetype (section 10.3 outer wrapper).",
  "properties": {
    "industry": {
      "title": "Industry",
      "type": "string"
    },
    "matrix": {
      "items": {
        "$ref": "#/$defs/ImpactMatrixEntry"
      },
      "minItems": 1,
      "title": "Matrix",
      "type": "array"
    },
    "archetype_class": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archetype Class"
    },
    "version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Version"
    }
  },
  "required": [
    "industry",
    "matrix"
  ],
  "title": "ImpactMatrix",
  "type": "object"
}
