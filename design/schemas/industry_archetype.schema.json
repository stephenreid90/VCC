    },
    "LifecycleStage": {
      "description": "Industry lifecycle stage (section 7.3).",
      "enum": [
        "emerging",
        "growth",
        "mature",
        "declining"
      ],
      "title": "LifecycleStage",
      "type": "string"
    },
    "Payor": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "channel": {
          "$ref": "#/$defs/PayorChannel"
        },
        "share_of_revenue": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Share Of Revenue",
          "type": "number"
        }
      },
      "required": [
        "name",
        "channel",
        "share_of_revenue"
      ],
      "title": "Payor",
      "type": "object"
    },
    "PayorAndRegulator": {
      "additionalProperties": false,
      "description": "Details block when type == payor_and_regulator (section 7.5.1).",
      "properties": {
        "axis_weight": {
          "enum": [
            "regulator_dominant",
            "payor_dominant",
            "both_material"
          ],
