          "type": "string"
        },
        "regulators": {
          "items": {
            "$ref": "#/$defs/Regulator"
          },
          "title": "Regulators",
          "type": "array"
        },
        "binding_constraints": {
          "items": {
            "$ref": "#/$defs/BindingConstraint"
          },
          "title": "Binding Constraints",
          "type": "array"
        },
        "regime": {
          "$ref": "#/$defs/RegulatoryRegimeDetail"
        },
        "dynamic": {
          "$ref": "#/$defs/RegulatoryDynamic"
        },
        "payors": {
          "items": {
            "$ref": "#/$defs/Payor"
          },
          "title": "Payors",
          "type": "array"
        },
        "payor_concentration": {
          "$ref": "#/$defs/Rating"
        },
        "payor_pricing_power": {
          "$ref": "#/$defs/Rating"
        },
        "payor_mix_evolution": {
          "$ref": "#/$defs/PayorMixEvolution"
        },
        "competitive_envelope": {
          "$ref": "#/$defs/CompetitiveEnvelope"
        },
        "asymmetries": {
          "items": {
            "$ref": "#/$defs/RegimeAsymmetry"
          },
          "title": "Asymmetries",
          "type": "array"
        }
      },
      "required": [
        "axis_weight",
        "regulators",
        "binding_constraints",
        "regime",
        "dynamic",
        "payors",
        "payor_concentration",
        "payor_pricing_power",
        "payor_mix_evolution",
        "competitive_envelope",
        "asymmetries"
      ],
      "title": "PayorAndRegulator",
      "type": "object"
    },
    "PayorChannel": {
      "enum": [
        "direct_payment",
        "insurance",
        "government_scheme",
        "rate_recovery",
        "fee_based"
