    "Rating": {
      "description": "Three-point ordinal \u2014 the standard across the framework.",
      "enum": [
        "low",
        "moderate",
        "high"
      ],
      "title": "Rating",
      "type": "string"
    },
    "RegimeAsymmetry": {
      "additionalProperties": false,
